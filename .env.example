# CLAUDIA EVERFORM — environment variables
# Nothing here is secret and every value has a working default, so the project runs
# without any of them set. On Vercel: Project → Settings → Environment Variables.
# For the scheduled sync: GitHub repo → Settings → Secrets and variables → Actions → Variables.

# Where the source archive lives (used by the website's status check and by the worker).
CLAUDIA_GALLERY_URL=https://claudia.gallery

# Public site URL (for Open Graph image resolution). Set this in Vercel to your real domain.
# NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Worker-only path overrides (defaults shown). Useful if you keep the heavy cache elsewhere.
# EVERFORM_DATA=data
# EVERFORM_CACHE=.cache/everform
# EVERFORM_PUBLIC=public/everform
# EVERFORM_MODELS=worker/models
